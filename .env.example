# ============================================================
# Autonomous Self-Healing Data Pipeline Agent - configuration
#
# Copy to `.env` and edit. Every value below is optional: the
# defaults shown are what the application uses if unset.
# `.env` is gitignored -- never commit real credentials.
# ============================================================

# -- Layer 2: LLM diagnosis ----------------------------------
# Without a key, Layer 2 uses its deterministic reasoning engine.
# Both layers report which engine produced a result, so you can
# always tell which path ran.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20

# -- API server ----------------------------------------------
# API_DEBUG enables the Werkzeug debugger, which permits ARBITRARY
# CODE EXECUTION by anyone who can reach the port. Leave it false,
# and never combine it with API_HOST=0.0.0.0.
API_HOST=127.0.0.1
PORT=5000
API_DEBUG=false

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -- Logging -------------------------------------------------
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
AUDIT_LOG_MAX_BYTES=5242880
AUDIT_LOG_BACKUP_COUNT=3
AUDIT_LOG_MAX_LIMIT=500

# -- Upstream ingestion --------------------------------------
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_LATITUDE=40.7128
WEATHER_LONGITUDE=-74.0060
HTTP_TIMEOUT_SECONDS=10

# -- Layer 1: detection --------------------------------------
RANDOM_SEED=42
TEST_SPLIT_SIZE=0.2
# Minimum string similarity before two keys are inferred to be a rename.
KEY_SIMILARITY_THRESHOLD=0.4

# -- Layer 3: patching & sandbox -----------------------------
MAX_HEAL_RETRIES=3
SANDBOX_TIMEOUT_SECONDS=15
VERIFICATION_SAMPLE_SIZE=120
