# Google Gemini API Key for Layer 2 LLM Diagnostic Reasoning (Optional)
# If not provided, the pipeline gracefully defaults to the built-in deterministic reasoning engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Server Port (Default: 5000)
PORT=5000

# Logging Level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO
